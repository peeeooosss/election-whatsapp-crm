# Copy this file to `.env` and adjust the values for your election campaign.

# Port the web server listens on. On hosting platforms this is injected (Railway/Render/Fly).
PORT=3000

# Address to bind. Use 0.0.0.0 on hosted platforms.
HOST=0.0.0.0

# Default country code (without "+") prepended to 10-digit phone numbers.
# Number = 11777009900 -> "91" + "11777009900" = 9111777009900
DEFAULT_COUNTRY_CODE=91

# WhatsApp auth creds directory. On a persistent host, point this at a mounted
# volume (e.g. /data/sessions on Railway/Render) so the linked device persists
# between deployments. Leave unset to use ./sessions locally.
# SESSIONS_DIR=/data/sessions

# Anti-ban pacing: random delay between messages (milliseconds).
MIN_DELAY_MS=30000
MAX_DELAY_MS=55000

# Batch break: after every N messages, pause for BATCH_PAUSE_MS.
BATCH_SIZE=50
BATCH_PAUSE_MS=900000

# Baileys log level: 'silent', 'error', 'warn', 'info', 'debug', 'trace'.
LOG_LEVEL=silent
