# Copy this file to `.env` and adjust the values.

# Port the web server listens on.
PORT=3000

# Address to bind. Use 0.0.0.0 on hosted platforms.
HOST=0.0.0.0

# Default country code (without "+") prepended to 10-digit phone numbers.
DEFAULT_COUNTRY_CODE=91

# WhatsApp auth creds directory. On a persistent host, point this at a mounted volume.
# SESSIONS_DIR=/data/sessions

# Anti-ban pacing: random delay between messages (milliseconds).
MIN_DELAY_MS=30000
MAX_DELAY_MS=55000

# Batch break: after every N messages, pause for BATCH_PAUSE_MS.
BATCH_SIZE=50
BATCH_PAUSE_MS=900000

# Baileys log level: 'silent', 'error', 'warn', 'info', 'debug', 'trace'.
LOG_LEVEL=silent

# JWT secret for authentication. Change this to a random string in production.
JWT_SECRET=change-me-to-a-random-string

# Admin email (the account that can approve purchases and see admin panel).
ADMIN_EMAIL=piyushbhuyan71@gmail.com

# UPI details shown to customers when buying credits.
UPI_ID=9864854881@ptsbi
UPI_NAME=Piyush Bhuyan
