# Copy this file to `.env` and adjust the values.

# Port the web server listens on.
PORT=3000

# Address to bind. Use 0.0.0.0 on hosted platforms.
HOST=0.0.0.0

# Default country code (without "+") prepended to 10-digit phone numbers.
DEFAULT_COUNTRY_CODE=91

# Neon Postgres connection string. Remove channel_binding=require if present.
DATABASE_URL=

# Anti-ban pacing: random delay between messages (milliseconds).
# First WARMUP_SEND_COUNT messages go at the slower warm-up rate.
MIN_DELAY_MS=20000
MAX_DELAY_MS=35000
WARMUP_SEND_COUNT=15
WARMUP_MIN_DELAY_MS=45000
WARMUP_MAX_DELAY_MS=60000

# Batch break: after every N messages, pause for BATCH_PAUSE_MS.
BATCH_SIZE=50
BATCH_PAUSE_MS=900000

# Baileys log level: 'silent', 'error', 'warn', 'info', 'debug', 'trace'.
LOG_LEVEL=silent

# JWT secret for authentication. Change this to a random string in production.
JWT_SECRET=change-me-to-a-random-string

# Free signup bonus credits.
FREE_CREDITS=50

# Pricing: ₹ per message and min/max pack size.
PRICE_PER_MSG=0.4
MIN_QTY=100
MAX_QTY=1000

# Admin email (the account that can approve purchases and see admin panel).
ADMIN_EMAIL=piyushbhuyan71@gmail.com

# UPI details shown to customers when buying credits.
UPI_ID=9864854881@ptsbi
UPI_NAME=Piyush Bhuyan

# Admin WhatsApp number (without +) used for the "Text me on WhatsApp" buy button.
ADMIN_WHATSAPP=9864854881
